# Frontend environment variables
# All must start with VITE_ to be exposed to the browser

# Clerk publishable key (safe to expose — it's designed to be public)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend API URL
# In development: leave empty (Vite proxy handles /api → localhost:4000)
# In production: set to your deployed backend URL
VITE_API_URL=
