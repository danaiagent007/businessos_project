# Server
PORT=4000
NODE_ENV=development

# MongoDB Atlas — your cluster
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/businessos?appName=Cluster0

# Clerk — fill these in after Step 2
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Upstash Redis — fill these in after Step 3
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# AI — Groq (primary, comma-separated for key rotation)
GROQ_API_KEYS=gsk_...

# AI — Gemini (secondary, comma-separated for key rotation)
GEMINI_API_KEYS=AQ...

# Frontend URL (for CORS)
ALLOWED_ORIGINS=http://localhost:3000

# ─── WhatsApp Business API (fill these in after Meta Business setup) ───────────
# Get from: developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_TOKEN=EAA...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Choose any secret string — you'll paste it in Meta dashboard when setting up webhook
WHATSAPP_VERIFY_TOKEN=my-secret-verify-token-123

# Your Clerk Organization ID — used to scope incoming WhatsApp messages
# Find it at: clerk.com → Organizations → your org → ID
DEFAULT_ORG_ID=org_3JRWqUdUPQPnD1sydU7GyG1EEPP
